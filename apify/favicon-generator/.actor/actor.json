{
  "actorSpecification": 1,
  "name": "favicon-generator",
  "title": "Favicon Generator (ICO, Apple Touch, PWA Manifest, Bulk)",
  "description": "Turn a logo URL into a complete favicon set: favicon.ico (16/32/48), PNG favicons, Apple touch icon, Android/PWA icons, a maskable icon and site.webmanifest, plus the HTML tags. Square, rounded or circle, in bulk. Pay per icon set.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 4096,
  "defaultMemoryMbytes": 512,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Favicon sets",
          "transformation": { "fields": ["previewUrl", "name", "appName", "zipUrl", "error", "url"] },
          "display": {
            "component": "table",
            "properties": {
              "previewUrl": { "label": "Icon", "format": "image" },
              "zipUrl": { "label": "Favicon ZIP", "format": "link" },
              "url": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
