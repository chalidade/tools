{
  "actorSpecification": 1,
  "name": "pdf-to-markdown",
  "title": "PDF to Markdown for LLM & RAG (Bulk, tables & headings)",
  "description": "Convert PDFs to clean Markdown in bulk from URLs: headings by font size, bold/italic, bullet and numbered lists, real Markdown tables (even across pages). Ready for ChatGPT, Claude, LangChain and vector databases. Pay per page.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 4096,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Markdown",
          "transformation": {
            "fields": ["name", "title", "pages", "headings", "tables", "characters", "downloadUrl", "markdown", "error", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "downloadUrl": { "label": "Download .md", "format": "link" },
              "url": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
