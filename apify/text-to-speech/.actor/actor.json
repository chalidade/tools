{
  "actorSpecification": 1,
  "name": "text-to-speech-mp3",
  "title": "Text to Speech MP3 (Neural English + 100+ Languages)",
  "description": "Turn texts into MP3, WAV, M4A, OGG or FLAC in bulk: a natural English neural voice (Piper) and eSpeak NG voices for 100+ languages including Indonesian. Speed and pitch control, one ZIP. No third-party API. Pay per 1,000 characters.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 4096,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Speech files",
          "transformation": {
            "fields": [
              "name",
              "voice",
              "characters",
              "duration",
              "downloadUrl",
              "text",
              "error"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "duration": {
                "label": "Duration (s)",
                "format": "number"
              },
              "characters": {
                "label": "Characters",
                "format": "number"
              },
              "downloadUrl": {
                "label": "Download",
                "format": "link"
              }
            }
          }
        }
      }
    }
  }
}
