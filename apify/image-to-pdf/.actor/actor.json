{
  "actorSpecification": 1,
  "name": "image-to-pdf",
  "title": "Image to PDF Converter (JPG, PNG, WebP to PDF, Bulk)",
  "description": "Convert images to PDF in bulk from URLs: combine many photos or scans into one PDF, or one PDF per image. A4, Letter or fit-to-image pages, auto orientation, margins, EXIF rotation, size-friendly JPEG. Pay per image.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 4096,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Images and PDFs",
          "transformation": {
            "fields": ["name", "width", "height", "pages", "sizeKb", "pdfUrl", "error", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "pdfUrl": { "label": "Download PDF", "format": "link" },
              "url": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
