{
  "actorSpecification": 1,
  "name": "pdf-compressor",
  "title": "PDF Compressor (Bulk, keeps text)",
  "description": "Shrink PDFs in bulk from URLs. Downsamples and re-encodes embedded photos, recompresses streams and packs objects, while text stays real, selectable text. Pay per PDF.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 4096,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Compressed PDFs",
          "transformation": {
            "fields": ["name", "downloadUrl", "sizeBefore", "sizeAfter", "savedPercent", "imagesShrunk", "error", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "downloadUrl": { "label": "Download", "format": "link" },
              "sizeBefore": { "label": "Before (bytes)", "format": "number" },
              "sizeAfter": { "label": "After (bytes)", "format": "number" },
              "savedPercent": { "label": "Saved %", "format": "number" },
              "url": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
