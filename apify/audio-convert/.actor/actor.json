{
  "actorSpecification": 1,
  "name": "audio-converter",
  "title": "Audio Converter (MP3, M4A, WAV, OGG, Opus, FLAC, Bulk)",
  "description": "Convert audio in bulk from URLs: WAV/FLAC/M4A/OGG/AMR/WMA and the sound of any video (MP4, MOV, WebM) to MP3, M4A, WAV, OGG, Opus or FLAC. Trim, mono, sample rate, fades, silence removal and loudness normalisation. ffmpeg, no third-party API. Pay per file.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 8192,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Converted audio",
          "transformation": {
            "fields": ["name", "downloadUrl", "inputCodec", "outputFormat", "duration", "channels", "sampleRate", "sizeBefore", "sizeAfter", "error", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "downloadUrl": { "label": "Download", "format": "link" },
              "duration": { "label": "Duration (s)", "format": "number" },
              "sizeBefore": { "label": "Before (bytes)", "format": "number" },
              "sizeAfter": { "label": "After (bytes)", "format": "number" },
              "url": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
