{
  "actorSpecification": 1,
  "name": "video-frame-extractor",
  "title": "Video Frame Extractor & Thumbnail Maker (Bulk)",
  "description": "Extract frames from videos in bulk from URLs: one every N seconds, N evenly spaced thumbnails, exact timestamps or every scene change. JPG, PNG or WebP, optional resize. For datasets, AI vision, previews and thumbnails. ffmpeg, no third-party API. Pay per video.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 1024,
  "maxMemoryMbytes": 8192,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Extracted frames",
          "transformation": {
            "fields": ["name", "firstFrame", "frameCount", "duration", "width", "height", "fps", "error", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "firstFrame": { "label": "First frame", "format": "image" },
              "frameCount": { "label": "Frames", "format": "number" },
              "duration": { "label": "Duration (s)", "format": "number" },
              "url": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
