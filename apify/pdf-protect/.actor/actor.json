{
  "actorSpecification": 1,
  "name": "pdf-password-protect",
  "title": "PDF Password Protect & Unlock (Bulk, AES-256, Per-File Passwords)",
  "description": "Lock PDFs with a password in bulk (AES-256), each file with its own password if you like (payslips, statements, reports), and block printing, copying or editing. Or unlock PDFs you have the password for. Pay per PDF.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 4096,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "PDFs",
          "transformation": {
            "fields": ["name", "operation", "opensWithPassword", "encryption", "sizeKb", "pdfUrl", "error", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "pdfUrl": { "label": "Download PDF", "format": "link" },
              "url": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
