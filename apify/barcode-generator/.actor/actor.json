{
  "actorSpecification": 1,
  "name": "barcode-generator",
  "title": "Barcode Generator (Bulk EAN-13, UPC, Code 128, SVG & PNG)",
  "description": "Generate barcodes in bulk: EAN-13, EAN-8, UPC-A/E, ISBN, Code 128, Code 39, ITF-14, GS1-128, Codabar, Data Matrix, PDF417 and Aztec. Auto-detects the type, PNG or vector SVG, custom colours, check digits validated, one ZIP. Pay per barcode.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 4096,
  "defaultMemoryMbytes": 512,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Barcodes",
          "transformation": { "fields": ["pngUrl", "text", "type", "svgUrl", "error"] },
          "display": {
            "component": "table",
            "properties": {
              "pngUrl": { "label": "Barcode", "format": "image" },
              "text": { "label": "Value" },
              "type": { "label": "Type" },
              "svgUrl": { "label": "SVG", "format": "link" }
            }
          }
        }
      }
    }
  }
}
