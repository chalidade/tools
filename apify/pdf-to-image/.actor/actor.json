{
  "actorSpecification": 1,
  "name": "pdf-to-image",
  "title": "PDF to JPG, PNG & WebP Converter (Bulk, any DPI)",
  "description": "Convert PDF pages to JPG, PNG or WebP images in bulk from URLs: every page or a range, 36–600 DPI or a fixed size for thumbnails, a ZIP per PDF, password-protected files too. Poppler rendering. Pay per page.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 8192,
  "defaultMemoryMbytes": 1024,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Rendered PDFs",
          "transformation": {
            "fields": ["name", "firstPage", "zipUrl", "pages", "totalPages", "format", "error", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "firstPage": { "label": "First page", "format": "image" },
              "zipUrl": { "label": "All pages (ZIP)", "format": "link" },
              "pages": { "label": "Pages rendered", "format": "number" },
              "totalPages": { "label": "Pages in PDF", "format": "number" },
              "url": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
