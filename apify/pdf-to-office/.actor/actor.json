{
  "actorSpecification": 1,
  "name": "pdf-to-word-excel",
  "title": "PDF to Word & Excel Converter (Bulk DOCX, XLSX)",
  "description": "Convert PDFs to editable Word (DOCX) and Excel (XLSX) in bulk from URLs: paragraphs with fonts, bold and italic kept; tables to spreadsheet cells with real numbers and dates. No Microsoft Office or LibreOffice needed. Pay per page.",
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 4096,
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Converted files",
          "transformation": {
            "fields": ["name", "title", "pages", "docxUrl", "xlsxUrl", "tables", "rows", "error", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "docxUrl": { "label": "Word (.docx)", "format": "link" },
              "xlsxUrl": { "label": "Excel (.xlsx)", "format": "link" },
              "url": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
