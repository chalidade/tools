{
  "manifest_version": 3,
  "name": "toowl: PDF, Image & QR Tools (Offline)",
  "short_name": "toowl",
  "version": "1.0.0",
  "description": "Compress, convert and edit images and PDFs, and make QR codes, right in your browser. Files never leave your computer.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open toowl", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "host_permissions": ["https://api.gumroad.com/*", "https://api.lemonsqueezy.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Open toowl" }
  }
}
