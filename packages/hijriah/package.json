{
  "name": "@chalidade/hijriah",
  "version": "0.1.0",
  "description": "Convert Gregorian dates to the Hijri (Islamic) calendar and back, with a year of Islamic holidays: a drop-in <hijri-calendar> element plus a headless API.",
  "keywords": [
    "web component",
    "custom element"
  ],
  "license": "MIT",
  "author": "Chalid Ade Rahman",
  "homepage": "https://chalidade.github.io/tools/#/hijriah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chalidade/tools.git",
    "directory": "packages/hijriah"
  },
  "bugs": "https://github.com/chalidade/tools/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/element.js",
  "unpkg": "./dist/element.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "sideEffects": [
    "./dist/element.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --noEmit -p . && vite build && cp types/*.d.ts dist/",
    "prepublishOnly": "npm run build"
  }
}
